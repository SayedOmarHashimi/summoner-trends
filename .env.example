# Riot Games API key (Personal key).
# Get one at https://developer.riotgames.com/
# A Development key expires 24 hours after it is issued. A Personal key (applied
# for, and what this project assumes) does not expire on that schedule.
# Never commit the real key: .env is gitignored.
RIOT_API_KEY=RGAPI-00000000-0000-0000-0000-000000000000

# Platform routing value, used by Summoner-V4 and Champion-Mastery-V4.
# e.g. na1, euw1, eun1, kr, br1, la1, la2, oc1, tr1, ru, jp1
RIOT_REGION=na1

# Regional routing value, used by Account-V1 and Match-V5.
# One of: americas, europe, asia, sea
RIOT_ROUTING=americas

# Riot ID of the account to extract, in gameName#tagLine form.
RIOT_ID=YourName#NA1

# Local DuckDB warehouse file (gitignored).
DUCKDB_PATH=summoner_trends.duckdb

# Where raw API responses are landed before loading (gitignored).
RAW_DATA_DIR=data/raw
